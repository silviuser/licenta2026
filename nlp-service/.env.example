# CV Extractor Configuration
# Copy to .env and adjust values for your environment

# Minimum characters per page to consider extraction successful
CV_EXTRACTOR_MIN_CHARS_PER_PAGE=100

# Minimum ratio of alphabetic chars to total chars (0.0–1.0)
CV_EXTRACTOR_MIN_ALPHA_RATIO=0.4

# Minimum quality score to accept extraction without warning (0.0–1.0)
CV_EXTRACTOR_MIN_QUALITY_SCORE=0.5

# Path to Tesseract binary (leave empty to use system PATH)
# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux/Mac example: /usr/bin/tesseract
CV_EXTRACTOR_TESSERACT_CMD=

# Tesseract language codes (comma-separated, e.g. "eng,ron")
CV_EXTRACTOR_TESSERACT_LANG=eng+ron

# DPI for rendering PDF pages to images for OCR
CV_EXTRACTOR_OCR_DPI=300

# Log level: DEBUG, INFO, WARNING, ERROR
CV_EXTRACTOR_LOG_LEVEL=INFO

# Gap ratio threshold for detecting 2-column layout (fraction of page width)
CV_EXTRACTOR_COLUMN_GAP_RATIO=0.1
